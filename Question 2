package za.co.mattressapp;

import javax.swing.*;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;

public class QuestionTwoApp extends JFrame {
    private JTextField txtCustomerName, txtPrice;
    private JComboBox<String> cmbProduct;

    // Interface definition
    public interface IProductCalculations {
        double GetVat();
        double GetCommission();
        double GetTotal();
    }

    // ProductCalculations class implementing IProductCalculations
    public static class ProductCalculations implements IProductCalculations {
        private double price;

        public ProductCalculations(double price) {
            this.price = price;
        }

        @Override
        public double GetVat() {
            return price * 0.15;
        }

        @Override
        public double GetCommission() {
            return price * 0.05;
        }

        @Override
        public double GetTotal() {
            return price + GetVat() + GetCommission();
        }
    }

    // GUI Constructor
    public QuestionTwoApp() {
        setTitle("Product App");
        setSize(430, 280);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(null);

        // Labels
        JLabel lblCustomer = new JLabel("Customer Name:");
        lblCustomer.setBounds(25, 30, 120, 25);
        add(lblCustomer);

        JLabel lblProduct = new JLabel("Select Product:");
        lblProduct.setBounds(25, 80, 120, 25);
        add(lblProduct);

        JLabel lblPrice = new JLabel("Enter Price:");
        lblPrice.setBounds(25, 130, 120, 25);
        add(lblPrice);

        // Inputs
        txtCustomerName = new JTextField();
        txtCustomerName.setBounds(150, 30, 230, 25);
        add(txtCustomerName);

        String[] products = {
            "Cozy Nights Monarch",
            "Restonic Barbados",
            "Sealy Phuket"
        };
        cmbProduct = new JComboBox<>(products);
        cmbProduct.setBounds(150, 80, 230, 25);
        add(cmbProduct);

        txtPrice = new JTextField();
        txtPrice.setBounds(150, 130, 230, 25);
        add(txtPrice);

        // Process Button
        JButton btnProcess = new JButton("PROCESS");
        btnProcess.setBounds(150, 180, 230, 30);
        add(btnProcess);

        // Menu Bar Setup
        JMenuBar menuBar = new JMenuBar();
        
        JMenu menuFile = new JMenu("File");
        JMenuItem itemExit = new JMenuItem("Exit");
        menuFile.add(itemExit);

        JMenu menuTools = new JMenu("Tools");
        JMenuItem itemProcess = new JMenuItem("Process");
        JMenuItem itemClear = new JMenuItem("Clear");
        menuTools.add(itemProcess);
        menuTools.add(itemClear);

        menuBar.add(menuFile);
        menuBar.add(menuTools);
        setJMenuBar(menuBar);

        // Listeners
        btnProcess.addActionListener(e -> processOrder());
        itemProcess.addActionListener(e -> processOrder());
        itemClear.addActionListener(e -> clearFields());
        itemExit.addActionListener(e -> System.exit(0));
    }

    private void processOrder() {
        try {
            String customer = txtCustomerName.getText().trim();
            String product = (String) cmbProduct.getSelectedItem();

            if (customer.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Please enter customer name.", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }

            double price = Double.parseDouble(txtPrice.getText().trim());

            ProductCalculations calc = new ProductCalculations(price);
            double vat = calc.GetVat();
            double commission = calc.GetCommission();
            double total = calc.GetTotal();

            // Display message dialog
            String outputMsg = String.format(
                "Customer Name: %s\nProduct: %s\nVAT: R %.1f\nCOMMISSION: R %.1f\nTOTAL: R %.1f",
                customer, product, vat, commission, total
            );
            JOptionPane.showMessageDialog(this, outputMsg, "Message", JOptionPane.INFORMATION_MESSAGE);

            // Save to data.txt
            try (PrintWriter writer = new PrintWriter(new FileWriter("data.txt", true))) {
                writer.println("DATA LOG");
                writer.println("**************************************************");
                writer.println("Customer Name: " + customer);
                writer.println("Product: " + product);
                writer.println(String.format("VAT: R %.1f", vat));
                writer.println(String.format("COMMISSION: R %.1f", commission));
                writer.println(String.format("TOTAL: R %.1f", total));
                writer.println("**************************************************");
                writer.println();
            } catch (IOException ex) {
                JOptionPane.showMessageDialog(this, "Could not save to file.", "File Error", JOptionPane.ERROR_MESSAGE);
            }

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter a valid numeric price.", "Format Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void clearFields() {
        txtCustomerName.setText("");
        txtPrice.setText("");
        cmbProduct.setSelectedIndex(0);
    }

    // Main Method Execution
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new QuestionTwoApp().setVisible(true);
        });
    }
}
