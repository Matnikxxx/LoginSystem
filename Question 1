package za.co.mattressapp;

import java.util.Scanner;

public class QuestionOneApp {

    // Interface definition
    public interface IProduct {
        int GetTotalProductsSold();
        double GetAverageProductSold();
        String GetMostPopularProduct();
    }

    // Product Class implementing IProduct
    public static class Product implements IProduct {
        private String[] productNames;
        private int[][] monthlySales;

        public Product(String[] productNames, int[][] monthlySales) {
            this.productNames = productNames;
            this.monthlySales = monthlySales;
        }

        @Override
        public int GetTotalProductsSold() {
            int total = 0;
            for (int i = 0; i < monthlySales.length; i++) {
                for (int j = 0; j < monthlySales[i].length; j++) {
                    total += monthlySales[i][j];
                }
            }
            return total;
        }

        @Override
        public double GetAverageProductSold() {
            int total = GetTotalProductsSold();
            int count = 0;
            for (int i = 0; i < monthlySales.length; i++) {
                count += monthlySales[i].length;
            }
            if (count == 0) return 0.0;
            return (double) total / count;
        }

        @Override
        public String GetMostPopularProduct() {
            int maxSales = -1;
            int bestIndex = 0;

            for (int i = 0; i < monthlySales.length; i++) {
                int currentSales = 0;
                for (int j = 0; j < monthlySales[i].length; j++) {
                    currentSales += monthlySales[i][j];
                }
                if (currentSales > maxSales) {
                    maxSales = currentSales;
                    bestIndex = i;
                }
            }
            return productNames[bestIndex] + " (" + maxSales + ")";
        }
    }

    // PrintProduct Class to handle inputs and output report
    public static class PrintProduct {
        public void generateReport() {
            Scanner input = new Scanner(System.in);

            String[] products = {
                "Cozy Nights Monarch mattress",
                "Restonic Barbados mattress",
                "Sealy Phuket mattress"
            };

            int[][] salesData = new int[3][3];

            for (int i = 0; i < products.length; i++) {
                for (int j = 0; j < 3; j++) {
                    System.out.print("Enter number of sales for month " + (j + 1) + " for " + products[i] + ": ");
                    while (!input.hasNextInt()) {
                        System.out.print("Invalid input. Enter a number: ");
                        input.next();
                    }
                    salesData[i][j] = input.nextInt();
                }
            }

            Product reportProduct = new Product(products, salesData);

            System.out.println("\nPRODUCT SALES REPORT - 2026");
            System.out.println("**************************************************");
            System.out.println("TOTAL PRODUCT SALES: " + reportProduct.GetTotalProductsSold());
            System.out.println("AVERAGE PRODUCT SALES: " + (int)Math.round(reportProduct.GetAverageProductSold()));
            System.out.println("MOST POPULAR PRODUCT: " + reportProduct.GetMostPopularProduct());

            input.close();
        }
    }

    // Main Method Execution
    public static void main(String[] args) {
        PrintProduct printer = new PrintProduct();
        printer.generateReport();
    }
}
